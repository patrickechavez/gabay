<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	PrivacyInfo.xcprivacy, required for App Store submission.

	Apple validates this against the binary, so it has to stay true. Two rules:

	1. NSPrivacyAccessedAPITypes lists every "required reason" API the app and
	   its dependencies call. Adding a library usually means adding entries.

	2. NSPrivacyCollectedDataTypes describes data that leaves the device.
	   Gabay has no account and no server of its own: it downloads trails and
	   keeps everything else, including where somebody walked, on the phone.
	   So the list is empty, and it must stay empty.
-->
<plist version="1.0">
<dict>
	<!-- No cross-app tracking, no data brokers. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults holds app state: the catalog ETag, what has been seen. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access limited to this app's own defaults. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>

	<!-- Nothing is collected. Location never leaves the device. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
</dict>
</plist>
