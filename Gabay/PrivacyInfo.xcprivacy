<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	PrivacyInfo.xcprivacy — required for App Store submission.

	Two things must stay true here, and BOTH are per-project decisions:

	1. NSPrivacyAccessedAPITypes must list every "required reason" API the app
	   (and its dependencies) calls. The entries below cover what this template
	   itself uses. Adding an SDK usually means adding entries.

	2. NSPrivacyCollectedDataTypes must match what your backend actually
	   stores. The entries below describe the template's own behaviour: it
	   sends an email, name, user ID, and profile photo to your API for
	   account functionality, and does not track users across apps.

	Review this file before every submission. Apple validates it against the
	binary, and a mismatch is a rejection.
-->
<plist version="1.0">
<dict>
	<!-- The template does no cross-app tracking and links to no data brokers. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- ==== Required reason APIs ==== -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- ImageLoader reads file modification dates to expire its disk cache. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: timestamps of files inside the app's own container. -->
				<string>C617.1</string>
			</array>
		</dict>

		<!-- UserDefaults stores non-sensitive app state (onboarding seen,
		     last force-update prompt). Auth tokens live in the Keychain. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access limited to this app's own defaults. -->
				<string>CA92.1</string>
			</array>
		</dict>

		<!-- ImageLoader checks available capacity before writing to the cache. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- E174.1: to avoid writing when space is low. -->
				<string>E174.1</string>
			</array>
		</dict>
	</array>

	<!-- ==== Collected data ==== -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
