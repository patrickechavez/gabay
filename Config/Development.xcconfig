//
//  Development.xcconfig
//  Gabay
//

#include "Shared.xcconfig"


// Identity: differs per environment so all three can install side by side

// The app's unique ID on iOS
PRODUCT_BUNDLE_IDENTIFIER = com.patrick.Gabay.dev

// Name under the Home Screen icon
APP_DISPLAY_NAME = Development



// Request tuning

// A generous timeout while stepping through breakpoints
API_TIMEOUT_SECONDS = 30

// Two retries is plenty against a local server
API_MAX_RETRIES = 2

// On, so every request and response shows up in the console
API_LOGGING_ENABLED = YES



// Events/auth API

// No backend yet; point at a local one while developing
API_BASE_URL = http:/$()/localhost:5000



// Force update: scaffolding, no code reads these yet

// Where the Update button sends the user
UPDATE_URL = itms-apps:/$()/apple.com/app/id000000000

// Read by APIConfig, but nothing acts on it
FORCE_UPDATE_ENABLED = YES


// Certificate pinning

// Off so Charles/Proxyman can inspect traffic
CERT_PINNING_ENABLED = NO

// Base64 SHA-256 of your server's public key
PINNED_PUBLIC_KEY_HASHES =


// Enables #if DEVELOPMENT in Swift
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEVELOPMENT
