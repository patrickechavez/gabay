//
//  Production.xcconfig
//  Gabay
//
//  The only configuration real users run.
//

#include "Shared.xcconfig"


// Identity — differs per environment so all three can install side by side

// Changing this after release makes a NEW app, not an update
PRODUCT_BUNDLE_IDENTIFIER = com.patrick.Gabay

// Name under the Home Screen icon
APP_DISPLAY_NAME = Gabay



// Trail catalog

// "//" is a comment here, so escape the double slash as /$()/
CATALOG_URL = https:/$()/patrickechavez.github.io/gabay/trails



// Events/auth API

// Placeholder until the C# backend is deployed
API_BASE_URL = https:/$()/api.example.com



// Force update — scaffolding, no code reads these yet

// Replace id000000000 with your real App Store ID before shipping
UPDATE_URL = itms-apps:/$()/apple.com/app/id000000000

// Read by APIConfig, but nothing acts on it
FORCE_UPDATE_ENABLED = YES


// Certificate pinning

// YES with an empty list below would claim pinning but do none
CERT_PINNING_ENABLED = NO

// List two (current + next) so you can rotate keys without an app update
PINNED_PUBLIC_KEY_HASHES =


// Enables #if PRODUCTION in Swift
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) PRODUCTION
